# Postgres for the catalogue (own Supabase project, not the client knowledge base)
DATABASE_URL=

# Site
SITE_URL=https://shopping.passoagency.com
CONTACT_EMAIL=shopping@passoagency.com
# Business phone only. Never the founder's personal mobile.
CONTACT_PHONE=

# Awin Feed List Download link (Toolbox > Create-a-Feed). Contains the API key.
AWIN_FEED_LIST_URL=
# Extra Awin Create-a-Feed download URLs, comma separated (they contain the API key)
AWIN_FEED_URLS=

# Webgains feeds, JSON list. Domain required (Webgains links point at Webgains). URLs contain the key.
# [{"name":"Shop","domain":"shop.co.uk","url":"https://..."}]
WEBGAINS_FEEDS=
# Direct Google Shopping feeds from shops (XML or CSV/TSV), same JSON shape; domain optional
# Shopify stores: add "type":"shopify" and the store URL; optional "deliveryPence" (flat delivery)
DIRECT_FEEDS=

# Vercel Cron bearer secret
CRON_SECRET=

# Basic auth for /internal/compliance (area is closed when unset)
INTERNAL_USER=
INTERNAL_PASSWORD=

# Compliance alerts by email (Zoho SMTP: smtp.zoho.eu, port 465)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL=jordan@passoagency.com
ALERT_FROM=

# Optional overrides
MERCHANTS_TARGET=60
COMPARABLE_TARGET=50
