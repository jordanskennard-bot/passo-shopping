# Postgres for the catalogue (own Supabase project, not the client knowledge base)
DATABASE_URL=

# Site
SITE_URL=https://shopping.passoagency.com
CONTACT_EMAIL=shopping@passoagency.com
# Business phone only. Never the founder's personal mobile.
CONTACT_PHONE=

# Awin Create-a-Feed download URLs, comma separated (they contain the API key)
AWIN_FEED_URLS=

# Vercel Cron bearer secret
CRON_SECRET=

# Basic auth for /internal/compliance (area is closed when unset)
INTERNAL_USER=
INTERNAL_PASSWORD=

# Compliance alerts by email (Zoho SMTP: smtp.zoho.eu, port 465)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL=jordan@passoagency.com
ALERT_FROM=

# Optional overrides
MERCHANTS_TARGET=60
COMPARABLE_TARGET=50
